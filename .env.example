# --- Core backend (REQUIRED) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
SESSION_SECRET=generate-a-long-random-string
PORT=3000

# --- Dates/times / letter metadata (change between elections; edit + restart) ---
# Training orders (.env wins over DB order_config):
DISTRICT_NAME=Kakinada
ORDER_DATE=
ORDER_PLACE=Kakinada
ELECTION_YEAR=2026
TRAINING_DATE=
TRAINING_TIME_FROM=
TRAINING_TIME_TO=
# Orders / notifications:
POLLING_DATE_TIME=
DISTRIBUTION_CENTER=
DISTRIBUTION_REPORT_TIME=

# --- Fast2SMS (SMS channel) ---
# Required to enable SMS: FAST2SMS_API_KEY (only FAST2SMS_API_KEY is mandatory).
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=q

# --- Meta WhatsApp Cloud API (WhatsApp channel) ---
# Required to enable WhatsApp: WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
TRAINING_VENUE=
TRAINING_MANDAL=
