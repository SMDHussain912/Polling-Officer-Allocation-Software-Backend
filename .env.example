# --- Core backend (REQUIRED) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
SESSION_SECRET=generate-a-long-random-string
PORT=3000

# --- Dates/times (change between elections; edit + restart) ---
# Training batches: one date/time for ALL batches (location varies per batch).
TRAINING_DATE=
TRAINING_TIME_FROM=
TRAINING_TIME_TO=
# Orders / notifications:
POLLING_DATE_TIME=
DISTRIBUTION_CENTER=
DISTRIBUTION_REPORT_TIME=

# --- Fast2SMS (SMS channel) ---
# Required to enable SMS: FAST2SMS_API_KEY (only FAST2SMS_API_KEY is mandatory).
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=q

# --- Meta WhatsApp Cloud API (WhatsApp channel) ---
# Required to enable WhatsApp: WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# --- Gmail API (Email channel) ---
# Required to enable Email: GMAIL_SENDER_EMAIL + GMAIL_ACCESS_TOKEN
# (OAuth access token for the sender mailbox).
GMAIL_SENDER_EMAIL=
GMAIL_ACCESS_TOKEN=
